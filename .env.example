# Database (PostgreSQL connection string)
DATABASE_URL=postgres://user:password@localhost/dbname

# Connection pool (optional)
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=10

# Server port
PORT=8080

# Admin authentication password.
# Required: every write endpoint is rejected while this is unset.
ADMIN_PASSWORD=your_secure_password

# Comma-separated origins allowed to call this API from a browser.
# Wildcards are not accepted because credentials are enabled.
ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary (image upload)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
